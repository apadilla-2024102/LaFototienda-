<section class="section section--tight{% if section.settings.background == 'surface' %} section--surface{% endif %}" aria-label="{{ section.settings.heading | escape }}">
  <div class="page-width">
    <h2 class="visually-hidden">{{ section.settings.heading }}</h2>
    <ul class="trust__list" role="list">
      {%- for block in section.blocks -%}
        <li class="trust__item" data-reveal {{ block.shopify_attributes }}>
          <span class="trust__icon">{% render 'icon', name: block.settings.icon %}</span>
          <div>
            <h3 class="trust__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="trust__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Insignias de confianza",
  "tag": "div",
  "class": "section-trust",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título (solo lectores de pantalla)", "default": "Por qué comprar con nosotros" },
    {
      "type": "select",
      "id": "background",
      "label": "Fondo",
      "options": [
        { "value": "default", "label": "Blanco" },
        { "value": "surface", "label": "Gris claro" }
      ],
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Insignia",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "chat", "label": "Asesoría" },
            { "value": "lock", "label": "Pago seguro" },
            { "value": "truck", "label": "Envío" },
            { "value": "shield", "label": "Garantía" },
            { "value": "award", "label": "Calidad" },
            { "value": "store", "label": "Tienda" },
            { "value": "camera", "label": "Cámara" },
            { "value": "card", "label": "Tarjeta" }
          ],
          "default": "chat"
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Asesoría personalizada" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Expertos que te ayudan a elegir tu equipo." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Insignias de confianza",
      "blocks": [
        { "type": "badge", "settings": { "icon": "chat", "title": "Asesoría personalizada", "text": "Expertos en fotografía y video te ayudan a elegir." } },
        { "type": "badge", "settings": { "icon": "lock", "title": "Pagos seguros", "text": "Paga con tarjeta de forma 100% segura." } },
        { "type": "badge", "settings": { "icon": "truck", "title": "Envío gratis desde Q1,000", "text": "Entregas a toda Guatemala." } },
        { "type": "badge", "settings": { "icon": "shield", "title": "Garantía de 1 año", "text": "Productos originales con garantía." } }
      ]
    }
  ]
}
{% endschema %}
