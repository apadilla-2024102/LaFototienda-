{%- if section.blocks.size > 0 -%}
  <div class="announcement" role="region" aria-label="{{ section.settings.aria_label | escape }}">
    <div class="page-width">
      <ul class="announcement__list">
        {%- for block in section.blocks -%}
          <li class="announcement__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}{% render 'icon', name: block.settings.icon %}{%- endif -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra superior",
  "class": "section-announcement",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Descripción para lectores de pantalla", "default": "Horarios de nuestras tiendas" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensaje",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Texto", "default": "<strong>Design Center Zona 10:</strong> Lun a Sáb 10:00 – 19:00" },
        { "type": "url", "id": "link", "label": "Enlace (opcional)" },
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "none", "label": "Ninguno" },
            { "value": "clock", "label": "Reloj" },
            { "value": "map-pin", "label": "Ubicación" },
            { "value": "truck", "label": "Envío" },
            { "value": "phone", "label": "Teléfono" }
          ],
          "default": "clock"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra superior",
      "blocks": [
        { "type": "message", "settings": { "text": "<strong>Design Center Zona 10:</strong> Lun a Sáb 10:00 – 19:00" } },
        { "type": "message", "settings": { "text": "<strong>Plaza Siete Xela:</strong> Lun a Sáb 10:00 – 19:00" } }
      ]
    }
  ]
}
{% endschema %}
