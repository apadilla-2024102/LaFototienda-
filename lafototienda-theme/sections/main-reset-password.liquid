<div class="page-width account">
  <div class="account-box">
    <h1>{{ 'customer.reset.title' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field">
        <label for="ResetPassword">{{ 'customer.reset.password' | t }}</label>
        <input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="ResetPasswordConfirm">{{ 'customer.reset.confirm' | t }}</label>
        <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button button--full">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Nueva contraseña",
  "tag": "section",
  "settings": []
}
{% endschema %}
