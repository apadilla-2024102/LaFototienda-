<div class="account-box">
  {%- if settings.logo -%}
    {{ settings.logo | image_url: width: 400 | image_tag: alt: shop.name, widths: '200, 300, 400', style: 'margin: 0 auto 1.5rem; width: 180px;' }}
  {%- endif -%}
  <h1>{{ section.settings.heading | default: shop.name }}</h1>
  {%- if shop.password_message != blank -%}
    <p style="text-align:center;">{{ shop.password_message }}</p>
  {%- endif -%}
  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <div class="form-message form-message--error">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="field">
      <label for="PasswordInput">{{ 'customer.login.password' | t }}</label>
      <input type="password" name="password" id="PasswordInput" autocomplete="current-password" required>
    </div>
    <button type="submit" class="button button--full">{{ 'customer.login.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contraseña",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Muy pronto" }
  ]
}
{% endschema %}
