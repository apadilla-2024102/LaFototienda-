<div class="page-width account">
  <h1>{{ 'customer.account.title' | t }}</h1>
  <div class="account-grid">
    <div>
      <h2 class="h3">{{ 'customer.account.orders' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th scope="col">{{ 'customer.account.order' | t }}</th>
                  <th scope="col">{{ 'customer.account.date' | t }}</th>
                  <th scope="col">{{ 'customer.account.payment_status' | t }}</th>
                  <th scope="col">{{ 'customer.account.fulfillment_status' | t }}</th>
                  <th scope="col">{{ 'customer.account.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a href="{{ order.customer_url }}" class="link">{{ order.name }}</a></td>
                    <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                    <td>{{ order.financial_status_label }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_net_amount | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <p>{{ 'customer.account.no_orders' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
    <aside class="cart-summary">
      <h2 class="h3">{{ 'customer.account.details' | t }}</h2>
      <p><strong>{{ customer.name }}</strong><br>{{ customer.email }}</p>
      {%- if customer.default_address -%}
        <address>{{ customer.default_address | format_address }}</address>
      {%- endif -%}
      <p><a href="{{ routes.account_addresses_url }}" class="link">{{ 'customer.account.view_addresses' | t: count: customer.addresses_count }}</a></p>
      <a href="{{ routes.account_logout_url }}" class="button button--secondary button--full">{{ 'customer.account.logout' | t }}</a>
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "Mi cuenta",
  "tag": "section",
  "settings": []
}
{% endschema %}
