{% render 'breadcrumbs' %}
<div class="page-width">
  <h1>{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="cart-page" data-cart-page novalidate>
      <div>
        <ul class="cart-items" role="list">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <a href="{{ item.url }}" class="cart-item__media" tabindex="-1">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '110px', alt: item.image.alt | default: item.product.title }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
              <div>
                {%- if item.vendor != blank -%}<p class="card__vendor">{{ item.vendor }}</p>{%- endif -%}
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                {%- for property in item.properties -%}
                  {%- unless property.last == blank or property.first contains '_' -%}
                    <p class="cart-item__variant">{{ property.first }}: {{ property.last }}</p>
                  {%- endunless -%}
                {%- endfor -%}
                {%- for discount in item.line_level_discount_allocations -%}
                  <p class="cart-item__discount">{{ discount.discount_application.title }} (-{{ discount.amount | money }})</p>
                {%- endfor -%}
                <div class="cart-item__row">
                  <div class="quantity quantity--small">
                    <button type="button" data-qty-change="-1" aria-label="{{ 'products.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                    <input type="number" name="updates[]" id="Updates-{{ item.key }}" min="0" value="{{ item.quantity }}" aria-label="{{ 'products.quantity' | t }}">
                    <button type="button" data-qty-change="1" aria-label="{{ 'products.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
                  </div>
                  <div class="cart-item__price">
                    {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
                    {{ item.final_line_price | money }}
                  </div>
                  <a href="{{ item.url_to_remove }}" class="cart-item__remove" aria-label="{{ 'cart.remove_item' | t: title: item.product.title | escape }}">{% render 'icon', name: 'trash' %}</a>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <noscript><button type="submit" name="update" class="button button--secondary" >{{ 'cart.update' | t }}</button></noscript>
        {%- if section.settings.show_note -%}
          <div class="field cart-note">
            <label for="CartNote">{{ 'cart.note' | t }}</label>
            <textarea name="note" id="CartNote" form="CartForm">{{ cart.note }}</textarea>
          </div>
        {%- endif -%}
      </div>

      <aside class="cart-summary">
        {% render 'free-shipping-bar' %}
        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="cart-summary__row cart-summary__row--discount">
            <span>{{ discount.title }}</span><span>-{{ discount.total_allocated_amount | money }}</span>
          </div>
        {%- endfor -%}
        <div class="cart-summary__row">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-summary__note">{{ 'cart.taxes_and_shipping' | t }}</p>
        <button type="submit" name="checkout" class="button button--full">{% render 'icon', name: 'lock' %}{{ 'cart.checkout' | t }}</button>
        <a href="{{ routes.all_products_collection_url }}" class="button button--secondary button--full">{{ 'cart.continue_shopping' | t }}</a>
        {%- if shop.enabled_payment_types.size > 0 -%}
          <ul class="payment-icons payment-icons--center" role="list">
            {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
      </aside>
    </form>
  {%- else -%}
    <div class="cart-empty">
      {% render 'icon', name: 'cart' %}
      <p>{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'cart.continue_shopping' | t }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Carrito",
  "tag": "section",
  "class": "section-main-cart",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Permitir nota del pedido", "default": true }
  ]
}
{% endschema %}
