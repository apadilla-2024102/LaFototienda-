{%- liquid
  assign featured = section.settings.collection
  assign limit = section.settings.products_to_show
-%}
<section class="section{% if section.settings.background == 'surface' %} section--surface{% endif %}" aria-labelledby="Heading-{{ section.id }}">
  <div class="page-width">
    <div class="section-header" data-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-header__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 id="Heading-{{ section.id }}">{{ section.settings.heading | default: featured.title }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="section-header__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- if featured != blank and section.settings.show_view_all -%}
        <a href="{{ featured.url }}" class="link">{{ 'general.view_all' | t }}{% render 'icon', name: 'chevron-right' %}</a>
      {%- endif -%}
    </div>

    {%- if featured != blank and featured.products_count > 0 -%}
      <ul class="product-grid product-grid--3" role="list">
        {%- for item in featured.products limit: limit -%}
          <li>{% render 'product-card', card_product: item %}</li>
        {%- endfor -%}
      </ul>
    {%- elsif featured != blank -%}
      <p class="empty-state">{{ 'products.empty_collection' | t }}</p>
    {%- else -%}
      {%- comment -%} Vista previa en el editor cuando aún no se elige colección {%- endcomment -%}
      <ul class="product-grid product-grid--3" role="list">
        {%- for i in (1..limit) -%}
          {%- assign placeholder_index = i | modulo: 6 | plus: 1 -%}
          <li>
            <article class="card">
              <div class="card__media">{{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'card__image placeholder-svg' }}</div>
              <div class="card__body">
                <h3 class="card__title">{{ 'products.pick_collection' | t }}</h3>
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Productos destacados",
  "tag": "div",
  "class": "section-featured-products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "Precios especiales" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Ofertas del mes", "info": "Si lo dejas vacío se usa el nombre de la colección." },
    { "type": "text", "id": "text", "label": "Descripción", "default": "Aprovecha descuentos por tiempo limitado en equipo seleccionado." },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "products_to_show", "label": "Productos a mostrar", "min": 3, "max": 12, "step": 3, "default": 3 },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar enlace “Ver todo”", "default": true },
    {
      "type": "select",
      "id": "background",
      "label": "Fondo",
      "options": [
        { "value": "default", "label": "Blanco" },
        { "value": "surface", "label": "Gris claro" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    { "name": "Productos destacados" }
  ]
}
{% endschema %}
