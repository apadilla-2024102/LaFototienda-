<section class="section" id="contacto" aria-labelledby="Heading-{{ section.id }}">
  <div class="page-width">
    <div class="contact">
      <div data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-header__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 id="Heading-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="rte section-header__text">{{ section.settings.text }}</div>
        {%- endif -%}
        <ul class="contact__info" role="list">
          {%- if settings.org_phone != blank -%}
            <li>{% render 'icon', name: 'phone' %}<a href="tel:{{ settings.org_phone | remove: ' ' | remove: '-' }}">{{ settings.org_phone }}</a></li>
          {%- endif -%}
          {%- if settings.org_email != blank -%}
            <li>{% render 'icon', name: 'mail' %}<a href="mailto:{{ settings.org_email }}">{{ settings.org_email }}</a></li>
          {%- endif -%}
          {%- if settings.social_whatsapp_number != blank -%}
            <li>{% render 'icon', name: 'whatsapp' %}<a href="https://wa.me/{{ settings.social_whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}" target="_blank" rel="noopener">WhatsApp</a></li>
          {%- endif -%}
        </ul>
      </div>

      <div class="contact__form" data-reveal>
        {%- form 'contact', id: 'ContactForm' -%}
          {%- if form.posted_successfully? -%}
            <div class="form-message form-message--success" role="status">{{ 'contact.success' | t }}</div>
          {%- elsif form.errors -%}
            <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="form-grid form-grid--2">
            <div class="field">
              <label for="ContactForm-name">{{ 'contact.name' | t }}</label>
              <input type="text" id="ContactForm-name" name="contact[{{ 'contact.name' | t }}]" value="{{ form.name }}" autocomplete="name" required>
            </div>
            <div class="field">
              <label for="ContactForm-email">{{ 'contact.email' | t }} *</label>
              <input type="email" id="ContactForm-email" name="contact[email]" value="{{ form.email }}" autocomplete="email" spellcheck="false" autocapitalize="off" required>
            </div>
            <div class="field">
              <label for="ContactForm-phone">{{ 'contact.phone' | t }}</label>
              <input type="tel" id="ContactForm-phone" name="contact[{{ 'contact.phone' | t }}]" value="{{ form.phone }}" autocomplete="tel" pattern="[0-9\-\+\s]*">
            </div>
            {%- if section.settings.show_store_select -%}
              <div class="field">
                <label for="ContactForm-store">{{ 'contact.store' | t }}</label>
                <select id="ContactForm-store" name="contact[{{ 'contact.store' | t }}]">
                  <option value="{{ 'contact.any_store' | t }}">{{ 'contact.any_store' | t }}</option>
                  {%- assign store_names = section.settings.store_names | newline_to_br | split: '<br />' -%}
                  {%- for store_name in store_names -%}
                    {%- assign clean_name = store_name | strip -%}
                    {%- if clean_name != blank -%}<option value="{{ clean_name | escape }}">{{ clean_name }}</option>{%- endif -%}
                  {%- endfor -%}
                </select>
              </div>
            {%- endif -%}
            <div class="field field--full">
              <label for="ContactForm-body">{{ 'contact.message' | t }}</label>
              <textarea id="ContactForm-body" name="contact[{{ 'contact.message' | t }}]" rows="5" required>{{ form.body }}</textarea>
            </div>
          </div>
          <button type="submit" class="button">{{ 'contact.send' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Formulario de contacto",
  "tag": "div",
  "class": "section-contact",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "Contáctanos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "¿Necesitas asesoría?" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Escríbenos y uno de nuestros expertos te ayudará a encontrar el equipo ideal para tu proyecto.</p>" },
    { "type": "checkbox", "id": "show_store_select", "label": "Mostrar selector de tienda", "default": true },
    { "type": "textarea", "id": "store_names", "label": "Tiendas (una por línea)", "default": "Design Center Zona 10\nPlaza Siete Xela" },
    { "type": "paragraph", "content": "Los mensajes llegan al correo configurado en Configuración → Notificaciones." }
  ],
  "presets": [
    { "name": "Formulario de contacto" }
  ]
}
{% endschema %}
