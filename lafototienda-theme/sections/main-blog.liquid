{% render 'breadcrumbs' %}
<div class="page-width main-page">
  <h1>{{ blog.title }}</h1>
  {%- paginate blog.articles by section.settings.per_page -%}
    {%- if blog.articles.size > 0 -%}
      <ul class="article-grid" role="list">
        {%- for article in blog.articles -%}
          <li data-reveal>
            <article class="article-card">
              <a href="{{ article.url }}" class="article-card__media" tabindex="-1" aria-hidden="true">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: article.image.alt | default: article.title }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
              <div class="article-card__body">
                <p class="article-card__meta">{{ article.published_at | time_tag: format: 'date' }}{% if section.settings.show_author %} · {{ 'blog.by_author' | t: author: article.author }}{% endif %}</p>
                <h2 class="article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
                <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
                <a href="{{ article.url }}" class="link">{{ 'blog.read_more' | t }}{% render 'icon', name: 'chevron-right' %}</a>
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <p class="empty-state">{{ 'blog.no_articles' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Artículos por página", "min": 3, "max": 24, "step": 3, "default": 9 },
    { "type": "checkbox", "id": "show_author", "label": "Mostrar autor", "default": false }
  ]
}
{% endschema %}
