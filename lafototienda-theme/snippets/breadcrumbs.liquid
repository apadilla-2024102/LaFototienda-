{%- comment -%}
  Migas de pan visibles + JSON-LD BreadcrumbList.
{%- endcomment -%}
{%- liquid
  assign crumb_collection = collection
  if request.page_type == 'product' and crumb_collection == blank
    assign crumb_collection = product.collections.first
  endif
-%}
{%- capture crumbs -%}
  {%- case request.page_type -%}
    {%- when 'product' -%}
      {%- if crumb_collection -%}{{ crumb_collection.title }}~~{{ crumb_collection.url }}^^{%- endif -%}
      {{ product.title }}~~{{ product.url }}
    {%- when 'collection' -%}
      {{ collection.title }}~~{{ collection.url }}
    {%- when 'list-collections' -%}
      {{ 'collections.all_collections' | t }}~~{{ routes.collections_url }}
    {%- when 'page' -%}
      {{ page.title }}~~{{ page.url }}
    {%- when 'blog' -%}
      {{ blog.title }}~~{{ blog.url }}
    {%- when 'article' -%}
      {{ blog.title }}~~{{ blog.url }}^^{{ article.title }}~~{{ article.url }}
    {%- when 'search' -%}
      {{ 'search.title' | t }}~~{{ routes.search_url }}
    {%- when 'cart' -%}
      {{ 'cart.title' | t }}~~{{ routes.cart_url }}
  {%- endcase -%}
{%- endcapture -%}
{%- assign crumb_list = crumbs | strip | split: '^^' -%}
<nav class="breadcrumbs page-width" aria-label="{{ 'general.breadcrumbs' | t }}">
  <ol>
    <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
    {%- for crumb in crumb_list -%}
      {%- assign parts = crumb | split: '~~' -%}
      <li>
        {%- if forloop.last -%}
          <span aria-current="page">{{ parts[0] | strip }}</span>
        {%- else -%}
          <a href="{{ parts[1] | strip }}">{{ parts[0] | strip }}</a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ol>
</nav>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'general.home' | t | json }},
        "item": {{ shop.url | append: routes.root_url | json }}
      }
      {%- for crumb in crumb_list -%}
        {%- assign parts = crumb | split: '~~' -%},
        {
          "@type": "ListItem",
          "position": {{ forloop.index | plus: 1 }},
          "name": {{ parts[0] | strip | json }},
          "item": {{ shop.url | append: parts[1] | strip | json }}
        }
      {%- endfor %}
    ]
  }
</script>
