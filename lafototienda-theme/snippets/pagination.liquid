{%- comment -%} Paginación. Parámetro: paginate {%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'pagination.label' | t }}">
    <ul>
      {%- if paginate.previous -%}
        <li>
          <a href="{{ paginate.previous.url }}" aria-label="{{ 'pagination.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</a>
        </li>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a href="{{ part.url }}" aria-label="{{ 'pagination.page' | t: number: part.title }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span aria-current="page">{{ part.title }}</span>
          {%- else -%}
            <span>{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
      {%- if paginate.next -%}
        <li>
          <a href="{{ paginate.next.url }}" aria-label="{{ 'pagination.next' | t }}">{% render 'icon', name: 'chevron-right' %}</a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
