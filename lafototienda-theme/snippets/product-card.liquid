{%- comment -%}
  Tarjeta de producto.
  Parámetros:
  - card_product: objeto product (obligatorio)
  - lazy: true/false (por defecto true)
  - sizes: atributo sizes de la imagen
  - heading_tag: h2 / h3 (por defecto h3)
{%- endcomment -%}
{%- liquid
  assign heading_tag = heading_tag | default: 'h3'
  assign img_sizes = sizes | default: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
  assign media = card_product.featured_media
  assign first_variant = card_product.selected_or_first_available_variant
-%}
<article class="card card--{{ settings.card_image_ratio }}" data-reveal>
  <div class="card__media">
    {%- if media -%}
      {{
        media.preview_image
        | image_url: width: 900
        | image_tag:
          widths: '240, 360, 480, 600, 750, 900',
          sizes: img_sizes,
          loading: loading,
          alt: media.alt | default: card_product.title,
          class: 'card__image'
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'card__image placeholder-svg' }}
    {%- endif -%}

    <div class="card__badges">
      {%- if card_product.available == false -%}
        <span class="badge badge--sold-out">{{ 'products.sold_out' | t }}</span>
      {%- elsif card_product.compare_at_price > card_product.price -%}
        {%- assign discount = card_product.compare_at_price | minus: card_product.price | times: 100.0 | divided_by: card_product.compare_at_price | round -%}
        <span class="badge badge--sale">{{ 'products.sale' | t }}</span>
        <span class="badge badge--discount">-{{ discount }}%</span>
      {%- endif -%}
    </div>
  </div>

  <div class="card__body">
    {%- if settings.card_show_vendor and card_product.vendor != blank -%}
      <p class="card__vendor">{{ card_product.vendor }}</p>
    {%- endif -%}
    <{{ heading_tag }} class="card__title">
      <a href="{{ card_product.url }}" class="card__link">{{ card_product.title }}</a>
    </{{ heading_tag }}>
    {% render 'price', product: card_product %}

    <div class="card__actions">
      {%- if card_product.available == false -%}
        <button type="button" class="button button--full" disabled>{{ 'products.sold_out' | t }}</button>
      {%- elsif card_product.has_only_default_variant -%}
        {%- form 'product', card_product, class: 'card__form', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ first_variant.id }}">
          <button type="submit" name="add" class="button button--full">
            {{ 'products.buy' | t }}
          </button>
        {%- endform -%}
      {%- else -%}
        <a href="{{ card_product.url }}" class="button button--full" tabindex="-1" aria-hidden="true">{{ 'products.buy' | t }}</a>
      {%- endif -%}
    </div>
  </div>
</article>
